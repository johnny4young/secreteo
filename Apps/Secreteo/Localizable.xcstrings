{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Allow microphone access in System Settings, then try dictation again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in System Settings, then try dictation again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micrófono en Ajustes del Sistema y vuelve a intentar el dictado."
          }
        }
      }
    },
    "Apple Speech could not start. Try Parakeet in Dictation settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech could not start. Try Parakeet in Dictation settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech no pudo iniciarse. Prueba Parakeet en los ajustes de Dictado."
          }
        }
      }
    },
    "Apple Speech does not support this language. Choose Parakeet in Dictation settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech does not support this language. Choose Parakeet in Dictation settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech no admite este idioma. Elige Parakeet en los ajustes de Dictado."
          }
        }
      }
    },
    "Apple Speech is unavailable. Choose Parakeet in Dictation settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech is unavailable. Choose Parakeet in Dictation settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech no está disponible. Elige Parakeet en los ajustes de Dictado."
          }
        }
      }
    },
    "Audio capture was interrupted. Nothing was inserted. Try dictating again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio capture was interrupted. Nothing was inserted. Try dictating again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpió la captura de audio. No se insertó nada. Vuelve a dictar."
          }
        }
      }
    },
